def render_empty_state(
    image_base_path: str = "assets/inspector",
    caption: str = "Koi evidence upload nahi hui. Shuru karne ke liye document ya image daalein.",
):
    """Render the animated empty-state illustration + caption in the app."""
    st.markdown(_CSS, unsafe_allow_html=True)

    data_uri = _load_custom_image(image_base_path)
    illustration = (
        f'<img src="{data_uri}" alt="Pramaan Lens illustration" />'
        if data_uri
        else _FALLBACK_SVG
    )

    st.markdown(
        f'<div class="pl-empty-state">{illustration}'
        f'<p class="pl-caption">{caption}</p></div>',
        unsafe_allow_html=True,
    )