"""
empty_state.py
-----------------------------------------------------------------------------
Animated "empty state" illustration for a Streamlit app (e.g. the
"Pramaan Lens" front page / no-file-uploaded state).

HOW THE "APNE AAP PRAKAT HONA" EFFECT WORKS
--------------------------------------------
There's no real magic here - it's just two ordinary web ideas stacked:

1. Conditional rendering: this function is only CALLED when there is
   nothing to show yet (e.g. `if uploaded_file is None:`). That alone
   makes it "appear" the moment the condition becomes true.
2. CSS animation: the moment that HTML lands in the page, a `@keyframes`
   animation plays automatically - no JavaScript needed. That's the
   fade-in/scale-up "pop" you saw in the reference video, plus a small
   idle animation on the magnifying-glass arm and the "?" bubble so it
   looks like she's actively inspecting.

HOW THE IMAGE FALLBACK WORKS
-----------------------------
render_empty_state() first looks on disk for a custom image at
    assets/inspector.svg / .png / .jpg / .jpeg
If you haven't added one yet, it automatically falls back to a built-in
inline SVG illustration, so the feature works today and will pick up your
real artwork later with zero code changes.

USAGE (inside your real app.py)
---------------------------------
    from empty_state import render_empty_state

    uploaded_file = st.file_uploader("Upload evidence")

    if uploaded_file is None:
        render_empty_state()        # <- shows itself, no extra logic needed
    else:
        ...                          # your normal results / analysis UI

To switch to your own illustration later, just save it as one of:
    assets/inspector.svg   (preferred - crisp at any size, keep under ~2000px)
    assets/inspector.png
    assets/inspector.jpg
and it is picked up automatically next run.
"""

import base64
import os

import streamlit as st

_CANDIDATE_EXTENSIONS = (
    (".svg", "image/svg+xml"),
    (".png", "image/png"),
    (".jpg", "image/jpeg"),
    (".jpeg", "image/jpeg"),
)


def _load_custom_image(base_path: str):
    """Return a data: URI for the first matching image file on disk, or None."""
    for ext, mime in _CANDIDATE_EXTENSIONS:
        path = f"{base_path}{ext}"
        if os.path.exists(path):
            with open(path, "rb") as f:
                encoded = base64.b64encode(f.read()).decode()
            return f"data:{mime};base64,{encoded}"
    return None


