"""

import streamlit as st

from empty_state import render_empty_state

st.set_page_config(page_title="Pramaan Lens - Empty State Demo", layout="centered")
st.title("Pramaan Lens")
st.caption("Forensic document / evidence analysis")

uploaded_file = st.file_uploader(
    "Evidence document upload karein", type=["pdf", "png", "jpg", "jpeg", "docx"]
)

if uploaded_file is None:
    render_empty_state()
else:
    st.success(f"Uploaded: {uploaded_file.name}")
    st.write("Yahan aapka normal analysis / results UI aayega.")